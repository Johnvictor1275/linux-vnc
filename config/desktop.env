# CloudPC desktop configuration.
# Never put passwords, tokens or other secrets in this file.

# Desktop environment
: "${DESKTOP_ENV:=xfce}"

# TigerVNC settings
: "${VNC_DISPLAY:=1}"
: "${VNC_PORT:=5900}"
: "${VNC_RESOLUTION:=1440x900}"
: "${VNC_COL_DEPTH:=24}"

# noVNC / WebSocket proxy
: "${NOVNC_PORT:=6080}"
