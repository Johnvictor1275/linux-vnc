# CloudPC desktop configuration. No credentials belong in this file.

DESKTOP_ENV=xfce

# TigerVNC display :1, explicitly assigned TCP port 5900.
VNC_DISPLAY=1
VNC_PORT=5900

# Browser noVNC / websockify port.
NOVNC_PORT=6080

# Codespaces already provides HTTPS for forwarded browser ports.
NOVNC_TLS=false

VNC_RESOLUTION=1440x900
VNC_COL_DEPTH=24
